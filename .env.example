# Copy to .env and adjust. Never commit .env.

# SQLite by default (no server needed). For PostgreSQL install the
# "postgres" extra and use e.g.
# QUANTSPORT_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/quantsport
QUANTSPORT_DATABASE_URL=

# Seconds to wait between HTTP requests to a data provider.
QUANTSPORT_REQUEST_DELAY=1.0
QUANTSPORT_HTTP_TIMEOUT=30
QUANTSPORT_HTTP_MAX_RETRIES=4

# Optional: OddAlerts paid API token (Advanced plan or API day pass).
# Without it the OddAlerts source is disabled; nothing is scraped.
ODDALERTS_API_TOKEN=
